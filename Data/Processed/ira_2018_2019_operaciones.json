        "value": ""
      }
    ],
    "description": "Crear la columna evento_grupo en el índice 7 mediante la obtención de URLs basadas en la columna evento_nombre utilizando la expresión grel:if(value.contains(\"ETI\"), \"ETI\", if(value.toLowercase().contains(\"neumon\"), \"Neumonía\", \"Bronquiolitis\"))"
  },
  {
    "op": "core/column-addition",
    "engineConfig": {
      "facets": [],
      "mode": "row-based"
    },
    "baseColumnName": "grupo_edad_desc",
    "expression": "grel:if(value.endsWith(\" m\"), value.replace(\" m\", \" meses\"), if(value == \">= a 75\", \"75 años o más\", if(value == \"Edad Sin Esp.\", \"Sin especificar\", value + \" años\")))",
    "onError": "set-to-blank",
    "newColumnName": "grupo_edad",
    "columnInsertIndex": 10,
    "description": "Crear la columna grupo_edad en el índice 10 basada en la columna grupo_edad_desc usando la expresión grel:if(value.endsWith(\" m\"), value.replace(\" m\", \" meses\"), if(value == \">= a 75\", \"75 años o más\", if(value == \"Edad Sin Esp.\", \"Sin especificar\", value + \" años\")))"
  },
