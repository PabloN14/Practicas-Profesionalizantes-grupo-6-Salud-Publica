    "op": "core/column-addition-by-fetching-urls",
    "engineConfig": {
      "facets": [],
      "mode": "row-based"
    },
    "baseColumnName": "evento_nombre",
    "urlExpression": "grel:if(value.contains(\"ETI\"), \"ETI\", if(value.toLowercase().contains(\"neumon\"), \"Neumonía\", \"Bronquiolitis\"))",
    "onError": "set-to-blank",
    "newColumnName": "evento_grupo",
    "columnInsertIndex": 7,
    "delay": 500,
